# Server-side only. Set these in Vercel's environment settings. Never prefix them with VITE_.
MONGODB_URI=
MONGODB_DB=knowza_cms
CLOUDINARY_URL=
# Optional. Cloudinary folder for uploads.
# CLOUDINARY_FOLDER=knowza

# Optional. Set to "local" to run the CMS in browser storage with no backend.
# VITE_CMS_BACKEND=local
